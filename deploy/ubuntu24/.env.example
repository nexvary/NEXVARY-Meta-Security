# NEXVARY hardened HackGPT server
HACKGPT_DIR=/opt/nexvary-security/HackGpt

POSTGRES_PASSWORD=replace-generated-secret
REDIS_PASSWORD=replace-generated-secret
HACKGPT_SECRET_KEY=replace-generated-secret
HACKGPT_JWT_SECRET=replace-generated-secret
NEXVARY_GATEWAY_TOKEN=replace-generated-secret

# AI provider: leave empty to configure later.
OPENAI_API_KEY=
HACKGPT_MODEL=
HACKGPT_PROVIDER=

# Optional local AI
LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434
